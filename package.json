{
  "name": "sunterra-support",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "playwright test --project=mobile-iphone-14-pro --project=webview-shinephone",
    "test:all": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "check:webview": "next build --webpack && node scripts/scan-artifacts.mjs"
  },
  "browserslist": [
    "Chrome >= 80",
    "Safari >= 14",
    "Firefox >= 78",
    "Edge >= 80",
    ">0.5%",
    "not dead"
  ],
  "dependencies": {
    "browser-image-compression": "^2.0.2",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@csstools/postcss-cascade-layers": "^6.0.0",
    "@csstools/postcss-color-mix-function": "^4.0.4",
    "@csstools/postcss-oklab-function": "^5.0.4",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "postcss-nesting": "^14.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
