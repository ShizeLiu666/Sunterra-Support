# ────────────────────────────────────────────
# HMAC Token Signing
# ────────────────────────────────────────────
# 32-byte random string, hex-encoded
# Generate with: openssl rand -hex 32
HMAC_SECRET=your_hmac_secret_here

# Token validity period in seconds (default: 86400 = 24h)
TOKEN_TTL_SECONDS=86400

# ────────────────────────────────────────────
# Salesforce Integration (Client Credentials Flow)
# ────────────────────────────────────────────
# Connected App credentials (from SF Setup → App Manager → Manage)
SALESFORCE_CLIENT_ID=your_consumer_key_here
SALESFORCE_CLIENT_SECRET=your_consumer_secret_here

# Salesforce instance URL (e.g., https://sunterra.my.salesforce.com)
# For sandbox: https://sunterra--dev.sandbox.my.salesforce.com
SALESFORCE_INSTANCE_URL=https://your-instance.my.salesforce.com

# Salesforce API version (default: v62.0)
SALESFORCE_API_VERSION=v62.0

# Note: We use Client Credentials Flow, not Username-Password Flow.
# The "Run As User" is configured inside the Connected App in Salesforce.
# No SALESFORCE_USERNAME or SALESFORCE_PASSWORD needed.

# ────────────────────────────────────────────
# Feature flags
# ────────────────────────────────────────────
# Reverse-lookup inverter SN → Job__c (a.k.a. Installation) via SOSL at
# Customer_Care__c creation time. Currently OFF because ShinePhone v1
# sends 1..5 SNs as a comma-joined string and we can't disambiguate which
# one to query. Flip back to "true" once ShinePhone exposes a single-SN
# entry point and we want the matched-Job feature back.
ENABLE_SOSL_JOB_LOOKUP=false

# ────────────────────────────────────────────
# Environment
# ────────────────────────────────────────────
# 'development' enables dev tools like /dev/test-link
NODE_ENV=development
